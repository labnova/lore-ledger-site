[{"created":"2026-09-12","estrazione":9,"id":"STE-PER-0001","parent_id":null,"regione":null,"relazione":null,"sommario":"Ha costruito la Bilancia e ne ha nascosto lo spartito mancante nella fede nuziale.","tipo":"personaggio","titolo":"Aurelio Fabbri","universo":"steamverse"},{"created":"2026-09-12","estrazione":8,"id":"STE-INV-0001","parent_id":null,"poc":false,"regione":null,"relazione":null,"sommario":"Da una settimana suona una melodia che non è in nessuno spartito.","tipo":"invenzione","titolo":"Bilancia dei Cieli","universo":"steamverse"},{"created":"2026-09-12","estrazione":4,"id":"NEO-PER-0002","parent_id":"NEO-PER-0001","regione":"Calvenna","relazione":"espansione","sommario":"Apprendista di Juma; gli è stato affidato per un giorno il gallo che non combatte mai, e lo ha lasciato scappare di proposito.","tipo":"personaggio","titolo":"Amani Kiwele","universo":"neofeudal"},{"created":"2026-09-12","estrazione":5,"id":"NEO-CON-0001","parent_id":null,"regione":"Calvenna","relazione":null,"sommario":"Avviso ai fedeli sul sacchetto a quattro tasche","tipo":"contenuto","titolo":"Avviso ai fedeli sul sacchetto a quattro tasche","universo":"neofeudal"},{"created":"2026-09-12","estrazione":7,"id":"CYB-PER-0001","parent_id":null,"regione":"Nodo Ferro","relazione":null,"sommario":"Falsifica i log di latenza per far sembrare il canto casuale, e ogni notte ne conserva una copia vera.","tipo":"personaggio","titolo":"Ilse Varga","universo":"cyberverse"},{"created":"2026-09-12","estrazione":6,"id":"CYB-INV-0002","parent_id":"CYB-INV-0001","poc":true,"regione":null,"relazione":"corruzione","sommario":"Il coro dei sottopiani la canta più forte di quello ufficiale.","tipo":"invenzione","titolo":"Liturgia del Ping, versione pirata","universo":"cyberverse"},{"created":"2026-09-11","estrazione":2,"id":"NEO-PER-0001","parent_id":null,"regione":"Calvenna","relazione":null,"sommario":"Miniaturista da vent'anni senza saper leggere i versetti; riconosce ogni animale dalla forma, e quello scritto a matita non l'ha mai visto.","tipo":"personaggio","titolo":"Juma Mwangaza","universo":"neofeudal"},{"created":"2026-09-11","estrazione":3,"id":"NEO-GAD-0001","parent_id":null,"prod":true,"regione":"Calvenna","relazione":null,"sommario":"È un regalo dell'amante segreto.","tipo":"gadget","titolo":"Sacchetto di Juma","universo":"neofeudal"},{"created":"2026-09-11","estrazione":6,"id":"CYB-INV-0001","parent_id":null,"poc":false,"regione":null,"relazione":null,"sommario":"Da tre notti il canto risponde prima che qualcuno lo intoni.","tipo":"invenzione","titolo":"Liturgia del Ping","universo":"cyberverse"},{"created":"2026-09-10","estrazione":0,"id":"NEO-REG-calvenna","parent_id":null,"regione":null,"relazione":null,"sommario":"borgo chiuso; la bottega mutila e invecchia, i giovani non restano; Madre Iselda tiene registri segreti delle nascite","tipo":"regione","titolo":"Calvenna","universo":"neofeudal"},{"created":"2026-09-10","estrazione":1,"id":"NEO-INV-0002","parent_id":null,"poc":true,"regione":"Calvenna","relazione":null,"sommario":"Chi recita il rosario al contrario vince sempre, e nessuno sa perché.","tipo":"invenzione","titolo":"Rosario delle Quote","universo":"neofeudal"},{"created":"2026-09-10","estrazione":1,"id":"NEO-INV-0001","parent_id":null,"poc":false,"regione":"Calvenna","relazione":null,"sommario":"Madre Iselda nota che i galli vincenti nascono tutti nello stesso mese.","tipo":"invenzione","titolo":"Giudizio dei Galli di Calvenna","universo":"neofeudal"}]
